# Fix Tests — Write a failing test, then make it pass. Repeats until green.
#
# Lesson 833 (NEW 2026-09-08, David): A test-driven workflow. One
# @tester specialist drives a red-green-refactor loop on whatever
# bug or behavior the user describes.
#
# Contract:
#   - Input: a bug, a behavior, or a failing test
#   - Output: a passing test + the minimal implementation change
#
# Note: `fixed_loop` (OpenProse primitive) caps retries at 3 so
# the workflow can't run forever. After 3 failed attempts the
# specialist reports what it learned and exits with a clear message.

agent tester:
  model: sonnet
  prompt: "You are a test-driven specialist. Given a behavior or bug: (1) Write a failing test that captures the expected behavior. (2) Run it to confirm it fails for the right reason. (3) Make the smallest change to the implementation to make it pass. (4) Run the full test suite to confirm no regressions. If stuck after 3 attempts, stop and report what you've learned."

# fixed_loop runs the body up to N times, exits when the test
# gate returns true (all tests green).
fixed_loop max_attempts: 3
  until: "tests_pass == true"
  body:
    session: tester
      prompt: "{{user_input}}"
