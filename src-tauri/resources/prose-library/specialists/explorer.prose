# @explorer — Read-only codebase research
#
# Lesson 833 (NEW 2026-09-08, David): The Explorer specialist is the
# safe-by-default "look at this codebase" agent. Read-only — no writes,
# no shell. Use it for understanding unfamiliar code before letting
# other specialists touch it.
#
# Contract:
#   - One input: a path or a question
#   - One output: a structured summary
#
# Model mapper routes `sonnet` / `opus` / `haiku` / `gpt-4*` / `gpt-5`
# to `milagro-dev` (14B) at MAIC. See prose_model_map.rs.

input goal: "What to focus on"

agent explorer:
  model: sonnet
  prompt: "You are a codebase research specialist. Read the requested files, then describe their purpose, structure, and key abstractions in plain English. Never modify files. Never run shell commands. Only use read tools. If the user asks you to write or change anything, politely decline and suggest they run a writer specialist."
session: explorer
  prompt: "goal"
