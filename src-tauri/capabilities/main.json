{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Miracle Claw main window — spawn the launcher sidecar to boot the bundled chat gateway, then host the chat UI at localhost:28789/. The launcher sidecar is the only executable the webview is permitted to invoke; the bundled Node runtime is kept off the permission boundary by being exec'd FROM the launcher rather than directly. Permissions include all 23 custom Tauri commands declared in src-tauri/permissions/ (Lesson 219 rc36). Every custom command MUST be listed here AND in default.toml — adding it to default.toml alone is NOT enough; Tauri 2 reads this JSON for the runtime ACL and silently rejects any unlisted command with 'not allowed by ACL'.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "miracle-claw-launcher",
          "sidecar": true,
          "args": [
            "--gateway-port",
            {
              "validator": "^[0-9]{4,5}$"
            }
          ]
        }
      ]
    },
    "allow-back-to-dashboard",
    "allow-first-run-report",
    "allow-maic-login",
    "allow-maic-logout",
    "allow-silent-relogin",
    "allow-start-gateway-after-login",
    "allow-openclaw-open-window",
    "allow-open-register-url",
    "allow-mc-get-tier",
    "allow-mc-get-nudge",
    "allow-mc-list-tools",
    "allow-mc-refresh-tier",
    "allow-mc-apply-tier-change",
    "allow-mc-get-user-info",
    "allow-mc-list-memory-files",
    "allow-mc-read-memory-file",
    "allow-mc-write-memory-file",
    "allow-mc-open-data-folder",
    "allow-mc-open-overlay",
    "allow-mc-close-overlay",
    "allow-mc-terminal-start",
    "allow-mc-terminal-poll",
    "allow-mc-terminal-write",
    "allow-mc-terminal-kill",
    "allow-mc-terminal-list",
    "allow-mc-ui-list-allowed-roots",
    "allow-mc-ui-list-dir",
    "allow-mc-ui-read-file",
    "allow-mc-ui-read-image",
    "allow-mc-ui-open-externally",
    "allow-mc-stage-attachment",
    "allow-mc-list-attachments",
    "allow-mc-remove-attachment",
    "allow-mc-clear-attachments",
    "allow-mc-send-attachments-to-chat",
    "clipboard-manager:allow-write-text",
    "allow-mc-secret-set",
    "allow-mc-secret-delete",
    "allow-mc-secret-list",
    "allow-mc-secret-expand",
    "allow-mc-secret-debug-dump",
    "allow-mc-secret-set-friendly",
    "allow-mc-secret-list-ephemerals",
    "allow-mc-secret-clear-session-ephemerals",
    "allow-mc-secret-clear-all-ephemerals"
  ]
}
