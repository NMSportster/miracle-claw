<!-- MC-PATCH: mc-back-button -->
<!-- Lesson 502: chat-UI button as fallback to bridge pill (Lesson 491).
     The bridge pill uses Tauri IPC; this button uses window.location.href
     so it works even if Tauri invoke fails silently on the cross-origin
     page. Both render the same visual style; click handlers are
     independent. Patch is idempotent: this marker prevents re-applying. -->
<script type="module" src="./mc-back-button.js"></script>
<!-- Lesson 243 (rc53.9): 🔑 Secrets + 📎 Attach floating toolbar at the
     top-right of the OpenClaw chat page. David asked 2026-08-23 for
     the secrets and dragndrop icons on the right side of the chat
     topbar (which we can't splice into because it's a vendored React
     bundle). Same IPC-INDEPENDENT pattern as mc-back-button.js: detect
     by location.host === '127.0.0.1:28789', navigate via
     `window.location.href = 'tauri://localhost/index.html#mcAutoOpen=<key>'`,
     which MC's main.js boot interprets as "go to Terminal and open the
     named overlay". mc-chat-toolbar.js has its own idempotent gate. -->
<script type="module" src="./mc-chat-toolbar.js"></script>
