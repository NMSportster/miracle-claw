# ============================================================================
# Dockerfile.build — Cross-compile Miracle Claw UI for Windows from Linux
# ============================================================================
#
# OUTPUT: src-tauri/target/x86_64-pc-windows-msvc/release/bundle/nsis/*.exe
#
# Base image: messense/cargo-xwin (pre-built: rustup, cargo, cargo-xwin,
# clang, lld, wine, Windows target).
#
# Adds: Node.js 20 (for vite build), nsis (makensis) via apt, sccache
# (host-staged via scripts/install-sccache.sh).
# ============================================================================

FROM messense/cargo-xwin:latest AS toolchain

ENV DEBIAN_FRONTEND=noninteractive

# Add Node.js 20 + NSIS + GTK dev headers via apt
# (GTK is needed because the launcher sidecar's Cargo.toml transitively
# pulls in tauri → webkit → gtk-sys → gdk-sys during cargo build for the
# host Linux triple. We could split the launcher into its own crate to
# avoid this, but it's cheaper to just install libgtk-3-dev + libwebkit2gtk-4.1-dev.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    nsis \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version \
    && which makensis && makensis -VERSION 2>&1 | head -1

# Install sccache (staged from host via scripts/install-sccache.sh)
# chmod 755 explicitly so the binary is executable regardless of source perms
COPY .docker-sccache/sccache /tmp/sccache-stage
RUN install -m 0755 /tmp/sccache-stage /usr/local/bin/sccache \
    && rm /tmp/sccache-stage \
    && /usr/local/bin/sccache --version

# Configure cargo to use sccache
RUN mkdir -p /usr/local/cargo/sccache /root/.cargo \
    && printf '[build]\nrustc-wrapper = "/usr/local/bin/sccache"\n' \
       > /root/.cargo/config.toml

WORKDIR /io

CMD ["npm", "run", "tauri", "--", "build", \
     "--runner", "cargo-xwin", \
     "--target", "x86_64-pc-windows-msvc", \
     "--bundles", "nsis"]
