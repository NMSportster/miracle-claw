# Build artifacts
node_modules/
dist/
dist-new/
dist-fresh/
dist-old/
dist-stash/
dist-stash-2/
scripts/whatever
src-tauri/target/
target-linux/
src-tauri/gen/

# Tauri launcher sidecar (regenerated by build-launcher-sidecar.sh)
src-tauri/binaries/

# OpenClaw + Node bundle (regenerated by bundle-runtime.sh before each installer build)
# Note: trailing /* (not bare resources/) so we can re-include specific
# subdirs like prose-library/ below.
src-tauri/resources/*
!src-tauri/resources/prose-library/
# Lesson 1096 (NEW 2026-10-01, David): bundled modules catalog ships
# with the installer so the marketplace has something to show when
# MAIC's /v1/marketplace/modules is offline. Lives at src-tauri/ top
# level (not under resources/) so bundle-runtime.sh's rm -rf doesn't
# wipe it during the bundle step.
!src-tauri/modules-catalog.json
# Test for the catalog fallback, also lives outside resources/.
!src-tauri/resources/modules-catalog-fallback.test.mjs

# Lesson 833 (NEW 2026-09-08, David): MC's own built-in prose-library
# (workflows + specialists) ships with the installer. Unlike dist/
# node_modules/ etc., it's authored content, not a build artifact —
# bundle-runtime.sh leaves it alone on subsequent builds.

# Installer artifacts
dist-installers/

# OpenClaw + Node sources vendored here during bundle prep; regenerated before each build
# Use /* so the negation below can re-include subdirs (Lesson 978:
# depot/openclaw-patches/ is the source of truth for our edits to
# vendored openclaw files and IS tracked).
depot/*
# Lesson 978: depot/openclaw-patches/ is the source of truth for our
# edits to vendored openclaw files (MC-PATCH markers + content).
# These ARE tracked; bundle-runtime.sh blows them away on every
# `--force` extract so this dir is the only durable home.
!depot/openclaw-patches/
!depot/openclaw-patches/**

# maic-plugin install stamp
depot/**/.miracle-claw-installed-sha256

# bundle-runtime.sh vendor stamp
depot/**/.vendor-stamp

# maic-plugin test fixture (regenerated)
depot/**/test_plugin.js

# sccache artifacts (docker build cache, regenerated each container run)
.docker-sccache/

# OS / editor noise
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Logs / runtime
*.log
npm-debug.log*
yarn-debug.log*

# Local secrets (in case any get added later)
*.env
!.env.example

# Backup files from edits
depot/maic-plugin/index.js.bak

# Brand assets — only canonical files in git, intermediates are local-only
brand/__pycache__/
brand/variants/
brand/variants2/
brand/icon-preview.png
brand/icon-sizes.png
brand/master-preview.png
brand/master-preview@2x.png
brand/master-sizes.png
brand/lockup-horizontal-preview.png
brand/lockup-horizontal.svg

# Lock files
.build-windows-docker.lock
.build-linux.lock
dist.OLD.root-owned/
dist.root-owned-bak/

# mclaw headless companion binary
mclaw/target/
mclaw/dist/

# Old dist backups (Lesson: trash old build artifacts)
dist.old.*/
dist.root-owned-bak-*/
dist.root-owned-bak-rc*/
