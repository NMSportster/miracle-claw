# Build artifacts
node_modules/
dist/
dist-new/
dist-fresh/
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/        # launcher sidecar (regenerated by build-launcher-sidecar.sh)
src-tauri/resources/       # openclaw + node bundle (regenerated by bundle-runtime.sh)

# Installer artifacts
dist-installers/
depot/                     # openclaw + node sources vendored here during bundle prep

# OS / editor noise
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Logs / runtime
*.log
npm-debug.log*
yarn-debug.log*

# Local secrets (in case any get added later)
*.env
!.env.example